# paper: simulated fills. shadow: real Jupiter quotes on mainnet, nothing sent. live: real swaps with real SOL.
TRADING_MODE=paper
# Starting float in SOL (shadow and live). The drawdown stop and the sweep are measured against it.
FLOAT_SOL=
# Halt and close everything when the wallet falls this far below the float (0.05 to 0.5).
MAX_DRAWDOWN=0.2
# Jupiter swap API key (shadow and live), free from portal.jup.ag
JUPITER_API_KEY=
# devnet | testnet | mainnet-beta. Shadow and live need mainnet-beta (the default for them).
SOLANA_CLUSTER=
# RPC URL, e.g. a Helius mainnet URL. Defaults to the cluster's public RPC.
SOLANA_RPC_URL=
# Agent wallet secret key (base58 or JSON byte array). Create with: npm run wallet:new
AGENT_WALLET_SECRET=
# Profit destination. The sweep refuses any other address.
PROFIT_ADDRESS=5qmsMSPXoTWDfsEDLoo15ywoPLSiKB7zqRGR9dSVfQTA
# Claude powers the four agents. Without a key they use built-in rules.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-haiku-5-5
# Free backups, tried in order when Claude fails
GEMINI_API_KEY=
GROQ_API_KEY=
# Dashboard/API admin secret for the kill switch (>= 24 chars).
ADMIN_SECRET=
# Seconds between agent rounds.
ROUND_SECONDS=300
# Risk level: low | med | high
RISK_LEVEL=med
# Paper float in USD.
START_USD=100
DATA_PATH=./data/state.json
PORT=3000
# Axiom Degen scanner (/degen): paper trading and alerts only, free APIs.
DEGEN=on
DEGEN_SCAN_SECONDS=60
# Mainnet RPC for security checks and wallet tracking. Defaults to the public mainnet RPC.
DEGEN_RPC_URL=
# Wallets to track, as address:label pairs separated by commas.
DEGEN_WALLETS=
DEGEN_ALERT_SCORE=70
DEGEN_PAPER_USD=1000
DEGEN_PAPER_SIZE_USD=100
DEGEN_DATA_PATH=./data/degen.json
# Optional, free: Reddit app-only OAuth (cloud IPs are often blocked without it), Discord alerts, a local Ollama model.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
DEGEN_DISCORD_WEBHOOK=
OLLAMA_URL=
OLLAMA_MODEL=
# Pumpflip Telegram bot: posts Degen Radar calls to the channel with Buy, Chart, Stars tip and SOL donate buttons.
# Set the token only as a Railway variable, never in the repo. The bot must be an admin of the channel (post messages,
# change info) and a member of the discussion chat.
TELEGRAM_BOT_TOKEN=
TG_CHANNEL=@Pumpflip_fun
TG_CHAT=@Pumpflip_chat
# Telegram handle allowed to run the owner commands (/pause, /tone, /describe, /stars...).
TG_OWNER=Its_neroiq47
# Call voice: chill | spicy | dry. Owner can change it with /tone.
TG_TONE=chill
# Only post calls at or above this Degen Radar score (0 = every alert), at most this many per hour.
TG_CALL_SCORE=0
TG_CALLS_PER_HOUR=6
# Stars tip tiers (1 to 10000 each).
TG_TIP_STARS=50,250,1000
# SOL donations to PROFIT_ADDRESS: at least this many USD at the live SOL price, at most this many SOL (capped at 10).
TG_DONATE_MIN_USD=25
TG_DONATE_MAX_SOL=10
# Public URL for the /donate page. Railway's RAILWAY_PUBLIC_DOMAIN is used when this is empty.
PUBLIC_URL=
